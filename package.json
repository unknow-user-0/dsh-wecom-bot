{
  "name": "dsh-wecom-bot",
  "version": "0.1.0",
  "description": "企业微信智能机器人接入 DeepSeek Harness：长连接收消息、独立会话、人格与记忆",
  "license": "MIT",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["slots"],
      "external": ["react"]
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "sharp": "^0.34.0",
    "dsh-video-storyboard": "^0.7.4"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "wecom",
    "wework",
    "企业微信",
    "aibot"
  ],
  "files": [
    "src",
    "client",
    "personas",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  }
}
